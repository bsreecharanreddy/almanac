# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
# pytest-xdist writes one per worker as `.coverage.<hostname>.<pid>.<random>`.
# The hostname is the point: this repo has already paid for that once, when
# `Sree <sree@REDACTED-HOSTNAME.local>` leaked a machine name containing a
# personal name and took a git filter-repo rewrite over 126 commits to remove.
.coverage.*
coverage/
htmlcov/

# Data — never commit downloaded archive files or built tables
data/
*.json.gz
warehouse/
spark-warehouse/
metastore_db/
derby.log

# Delta / MLflow local artifacts
mlruns/
mlartifacts/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
!*.tf

# Secrets
.env
*.pem
*.key

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Story bank gist id — the gist is secret; its id stays out of the repo
.claude/story-bank-gist-id

# Local-only Claude Code settings (per-machine permission grants, etc.)
.claude/settings.local.json

# dbt build artifacts
dbt/target/
dbt/logs/
# generated by dbt on first run: an anonymous usage id, not source
dbt/.user.yml
dbt_packages/
logs/
