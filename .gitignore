# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
# pytest-xdist writes one per worker as `.coverage.<hostname>.<pid>.<random>`.
# The hostname is the point: this repo has already paid for that once, when a
# commit trailer leaked a machine name containing a personal name and took a
# git filter-repo rewrite over 126 commits to remove.
.coverage.*
coverage/
htmlcov/

# Data — never commit downloaded archive files or built tables. Anchored to
# the repo root: an unanchored `data/` also matched `demo/data/`, the
# committed build artifacts Phase 11 depends on, and silently ate them.
/data/
*.json.gz

# demo/data/ commits only the three named build artifacts (medallion.json,
# coverage.json, queue.parquet) -- the Bronze/Silver Delta lake the build
# step computes them from is scratch, same as the top-level warehouse above.
demo/data/lake/
warehouse/
spark-warehouse/
metastore_db/
derby.log

# Delta / MLflow local artifacts
mlruns/
mlartifacts/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
!*.tf

# Secrets
.env
*.pem
*.key

# Notebooks
.ipynb_checkpoints/

# OS / editor
.DS_Store
.idea/
.vscode/

# Story bank gist id — the gist is secret; its id stays out of the repo
.claude/story-bank-gist-id

# Local-only Claude Code settings (per-machine permission grants, etc.)
.claude/settings.local.json

# dbt build artifacts
dbt/target/
dbt/logs/
# generated by dbt on first run: an anonymous usage id, not source
dbt/.user.yml
dbt_packages/
logs/

# Browser-automation tool scratch (page snapshots, console logs) from manual
# verification sessions -- not project source.
/.playwright-mcp/

# graphify — local knowledge-graph build, treated as regenerable local state.
# The post-commit hook (`graphify hook install`) rebuilds graph.json on every
# commit, AST-only. A tracked copy would be dirty after every commit, and the
# hook's re-clustering decays the curated LLM community labels to mechanical
# hub-names because a git hook has no LLM. A fresh clone runs `/graphify` once.
graphify-out/
