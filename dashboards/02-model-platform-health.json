{
  "datasets": [
    {
      "name": "ds_funnel",
      "displayName": "Bronze -> Silver -> Gold row funnel",
      "queryLines": [
        "SELECT 'bronze' AS layer, count(*) AS rows_in_layer FROM delta.`abfss://bronze@almanaclakekoctmh.dfs.core.windows.net/events`\n",
        "UNION ALL SELECT 'silver', count(*) FROM almanac_dbx.silver.events\n",
        "UNION ALL SELECT 'silver_quarantine', count(*) FROM almanac_dbx.silver.events_quarantine\n",
        "UNION ALL SELECT 'gold_fact', count(*) FROM almanac_dbx.gold.fact_pull_request\n"
      ]
    },
    {
      "name": "ds_quarantine_by_rule",
      "displayName": "Quarantine rate by which rule fired",
      "queryLines": [
        "SELECT 'ALL RULES (total quarantined)' AS rule, count(*) AS rows_failed\n",
        "FROM almanac_dbx.silver.events_quarantine\n",
        "UNION ALL\n",
        "SELECT rule, count(*) AS rows_failed\n",
        "FROM almanac_dbx.silver.events_quarantine\n",
        "LATERAL VIEW explode(_failed_rules) t AS rule\n",
        "GROUP BY rule\n",
        "ORDER BY rows_failed DESC\n"
      ]
    },
    {
      "name": "ds_schema_eras",
      "displayName": "Schema-version distribution (the 2015 break)",
      "queryLines": [
        "SELECT schema_era, date_trunc('MONTH', created_at) AS month, count(*) AS events\n",
        "FROM almanac_dbx.silver.events\n",
        "GROUP BY schema_era, month\n",
        "ORDER BY month\n"
      ]
    },
    {
      "name": "ds_job_runs",
      "displayName": "Run duration and cost per run",
      "queryLines": [
        "SELECT job_id, run_id, period_start_time, period_end_time,\n",
        "       timestampdiff(SECOND, period_start_time, period_end_time) AS duration_seconds,\n",
        "       result_state\n",
        "FROM system.lakeflow.job_run_timeline\n",
        "WHERE period_start_time >= current_date() - INTERVAL 30 DAYS\n",
        "ORDER BY period_start_time DESC\n",
        "LIMIT 200\n"
      ]
    },
    {
      "name": "ds_prediction_volume",
      "displayName": "Prediction volume and served latency",
      "queryLines": [
        "SELECT date_trunc('HOUR', request_time) AS hour,\n",
        "       count(*) AS predictions,\n",
        "       round(avg(execution_duration_ms), 2) AS mean_model_ms,\n",
        "       max(execution_duration_ms) AS max_model_ms,\n",
        "       sum(CASE WHEN status_code <> 200 THEN 1 ELSE 0 END) AS non_200\n",
        "FROM almanac_dbx.serving_logs.pr_review_sla_risk_payload\n",
        "GROUP BY hour\n",
        "ORDER BY hour DESC\n"
      ]
    },
    {
      "name": "ds_model_metrics",
      "displayName": "Champion metrics, as registered",
      "queryLines": [
        "SELECT breach_risk_bucket, count(*) AS pull_requests\n",
        "FROM (SELECT round(breach_risk, 1) AS breach_risk_bucket\n",
        "      FROM almanac_dbx.features.pr_breach_predictions)\n",
        "GROUP BY breach_risk_bucket\n",
        "ORDER BY breach_risk_bucket\n"
      ]
    }
  ],
